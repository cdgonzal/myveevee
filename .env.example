# SWCA intake form API Gateway endpoint.
# Leave unset for local mock mode.
VITE_SWCA_INTAKE_API_URL=

# SWCA reward wheel spin API Gateway endpoint.
# Leave unset for local mock mode.
VITE_SWCA_REWARD_SPIN_API_URL=

# VeeVee Twin Card create-card API Gateway endpoint.
# Leave unset for local fallback mode.
VITE_TWIN_CARD_API_URL=

# Optional override for the provider inquiry endpoint in src/config/providerInquiry.json.
# Missing configuration fails visibly; this form never uses mock success.
VITE_PROVIDER_INQUIRY_API_URL=
